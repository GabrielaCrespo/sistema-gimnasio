# CONFIGURACIÓN LOCAL
.env

# DEPENDENCIAS
/vendor/
/node_modules/

# LOGS
/storage/logs/*
*.log

# VIDEOS E IMÁGENES LOCALES DE EJERCICIOS (subidos por el administrador/instructor),
# ambos dentro de una única carpeta "archivos/" con una subcarpeta por tipo.
/archivos/videos/*
!/archivos/videos/.gitkeep
/archivos/imagenes/*
!/archivos/imagenes/.gitkeep

# ARCHIVOS TEMPORALES
*.tmp
*.temp

# SISTEMA OPERATIVO
.DS_Store
Thumbs.db


# EDITORES / IDE
.vscode/
.idea/